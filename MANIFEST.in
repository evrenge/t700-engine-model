# What goes into an sdist beyond the package itself.
#
# `data/` is covered by `[tool.setuptools.package-data]` in pyproject.toml, which handles
# the wheel too. The rest is listed here because an sdist of a replication is only useful
# with the thing being replicated and the tools that read it.

include LICENSE README.md SCOPE.md CLAUDE.md
recursive-include data *.csv
recursive-include tests *.py
recursive-include validation *.py
recursive-include tools *.py *.sh
recursive-include docs/notes *.md

# The 12 MB source scan. Every citation in this repository is `pdf p.NN` against this exact
# file -- SHA-256 in docs/notes/environment.md -- so an sdist without it cannot be checked
# against anything.
include docs/ballin-tm100991.pdf

# Rendered page images and digitizer scratch: reproducible from the PDF, and 94 PNGs.
prune docs/extracted
prune validation/out
global-exclude *.pyc __pycache__
